      },
      "required": [
        "id",
        "name",
        "frame"
      ]
    },
    "terminal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$",
          "not": {
            "const": ".."
          }
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "power",
            "signal",
            "ground"
          ]
        },
        "frame": {
          "$ref": "#/$defs/frame"
        }
      },
      "required": [
        "id",
        "name",
        "kind",
        "frame"
      ]
    },
    "flexible": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "restLength": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "minimumLength": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "maximumLength": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "minimumBendRadius": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "maximumStretchRatio": {
          "type": "number",
          "minimum": 1,
          "maximum": 100
        },
        "skinSegments": {
          "type": "integer",
          "minimum": 2,
          "maximum": 4096
        }
      },
      "required": [
        "restLength",
        "minimumLength",
        "maximumLength",
        "minimumBendRadius",
        "maximumStretchRatio",
        "skinSegments"
      ]
    },
    "part": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$",
          "not": {
            "const": ".."
          }
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "detail": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "materialId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$",
          "not": {
            "const": ".."
          }
        },
        "kind": {
          "type": "string",
          "enum": [
            "rigid",
            "wire",
            "hose",
            "spring",
            "belt"
          ]
        },
        "size": {
          "$ref": "#/$defs/vec3"
        },
        "features": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/feature"
          },
          "maxItems": 131072,
          "minItems": 1
        },
        "interfaces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/port"
          },
          "maxItems": 4096,
          "minItems": 0
        },
        "terminals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/terminal"
          },
          "maxItems": 4096,
          "minItems": 0
        },
        "flexible": {
          "anyOf": [
            {
              "$ref": "#/$defs/flexible"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "name",
        "purpose",
        "detail",
        "materialId",
        "kind",
        "size",
        "features",
        "interfaces",
        "terminals",
        "flexible"
      ]
    },
    "subassembly": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$",
          "not": {
            "const": ".."
          }
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "parentId": {
          "anyOf": [
