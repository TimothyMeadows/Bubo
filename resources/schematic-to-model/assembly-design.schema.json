{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bubo:assembly-design:v1",
  "title": "Bubo schematic assembly design",
  "description": "Closed declaration shape. The native validator additionally checks numerical coherence, identities, references, geometry declarations, connectivity and budgets; this schema does not certify actual construction or motion.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "bubo-assembly-design/v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$",
      "not": {
        "const": ".."
      }
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "styleSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "coordinateSystem": {
      "const": "xy-metres-z-up"
    },
    "numerics": {
      "$ref": "#/$defs/numerics"
    },
    "budgets": {
      "$ref": "#/$defs/budgets"
    },
    "observations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/observation"
      },
      "maxItems": 4096,
      "minItems": 1
    },
    "materials": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/material"
      },
      "maxItems": 4096,
      "minItems": 1
    },
    "parts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/part"
      },
      "maxItems": 4096,
      "minItems": 1
    },
    "subassemblies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/subassembly"
      },
      "maxItems": 32768,
      "minItems": 1
    },
    "instances": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/instance"
      },
      "maxItems": 32768,
      "minItems": 1
    },
    "joints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/joint"
      },
      "maxItems": 32768,
      "minItems": 0
    },
    "mechanisms": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/mechanism"
      },
      "maxItems": 32768,
      "minItems": 0
    },
    "routes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/route"
      },
      "maxItems": 32768,
      "minItems": 0
    },
    "connections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/connection"
      },
      "maxItems": 32768,
      "minItems": 0
    },
    "sections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/section"
      },
      "maxItems": 128,
      "minItems": 1
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "name",
    "purpose",
    "styleSha256",
    "coordinateSystem",
    "numerics",
    "budgets",
    "observations",
    "materials",
    "parts",
    "subassemblies",
    "instances",
    "joints",
    "mechanisms",
    "routes",
    "connections",
    "sections"
  ],
  "$defs": {
    "vec2": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ]
    },
    "vec3": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "z"
      ]
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "origin": {
          "$ref": "#/$defs/vec3"
        },
        "rotationDegrees": {
          "$ref": "#/$defs/vec3"
        }
      },
      "required": [
        "origin",
        "rotationDegrees"
      ]
    },
    "numerics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "linearTolerance": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "angularToleranceDegrees": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "minimumFeatureSize": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "maxCoordinateMagnitude": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000000
        }
      },
      "required": [
        "linearTolerance",
        "angularToleranceDegrees",
        "minimumFeatureSize",
        "maxCoordinateMagnitude"
      ]
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxPartDefinitions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "maxInstances": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32768
        },
        "maxFeatures": {
          "type": "integer",
          "minimum": 1,
          "maximum": 131072
        },
        "maxRoutePoints": {
          "type": "integer",
          "minimum": 2,
          "maximum": 262144
        },
        "maxDrawings": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192
        },
        "maxValidationChecks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        },
        "maxPreviewBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        },
        "maxExportBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 17179869184
        },
        "maxGeneratedTriangles": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50000000
        },
        "maxMotionSamples": {
          "type": "integer",
          "minimum": 2,
          "maximum": 1000000
        }
      },
      "required": [
        "maxPartDefinitions",
        "maxInstances",
        "maxFeatures",
        "maxRoutePoints",
        "maxDrawings",
        "maxValidationChecks",
        "maxPreviewBytes",
        "maxExportBytes",
        "maxGeneratedTriangles",
        "maxMotionSamples"
      ]
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$",
          "not": {
            "const": ".."
          }
        },
        "kind": {
          "type": "string",
          "enum": [
            "observed",
            "assumed",
            "unresolved",
            "simplified"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        }
      },
      "required": [
        "id",
        "kind",
        "description",
        "source"
      ]
    },
    "material": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$",
          "not": {
            "const": ".."
          }
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "roughness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "metallic": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "id",
        "name",
        "color",
        "roughness",
        "metallic"
      ]
    },
    "loftSection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "frame": {
          "$ref": "#/$defs/frame"
        },
        "profile": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/vec2"
          },
          "maxItems": 4096,
          "minItems": 3
        }
      },
      "required": [
        "frame",
        "profile"
      ]
    },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$",
          "not": {
            "const": ".."
          }
        },
        "kind": {
          "type": "string",
          "enum": [
            "box",
            "cylinder",
            "extrude",
            "revolve",
            "sweep",
            "loft"
          ]
        },
        "operation": {
          "type": "string",
          "enum": [
            "add",
            "subtract"
          ]
        },
        "frame": {
          "$ref": "#/$defs/frame"
        },
        "parameters": {
          "type": "object",
          "maxProperties": 16,
          "additionalProperties": {
            "type": "number"
          }
        },
        "profile": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/vec2"
          },
          "maxItems": 4096,
          "minItems": 0
        },
        "path": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/vec3"
          },
          "maxItems": 262144,
          "minItems": 0
        },
        "sections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/loftSection"
          },
          "maxItems": 1024,
          "minItems": 0
        }
      },
      "required": [
        "id",
        "kind",
        "operation",
        "frame",
        "parameters",
        "profile",
        "path",
        "sections"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "box"
              }
            }
          },
          "then": {
            "properties": {
              "parameters": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "width": {
                    "type": "number"
                  },
                  "depth": {
                    "type": "number"
                  },
                  "height": {
                    "type": "number"
                  }
                },
                "required": [
                  "width",
                  "depth",
                  "height"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "cylinder"
              }
            }
          },
          "then": {
            "properties": {
              "parameters": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "radius": {
                    "type": "number"
                  },
                  "length": {
                    "type": "number"
                  },
                  "segments": {
                    "type": "number"
                  }
                },
                "required": [
                  "radius",
                  "length",
                  "segments"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "extrude"
              }
            }
          },
          "then": {
            "properties": {
              "parameters": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "depth": {
                    "type": "number"
                  }
                },
                "required": [
                  "depth"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "revolve"
              }
            }
          },
          "then": {
            "properties": {
              "parameters": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "angleDegrees": {
                    "type": "number"
                  },
                  "segments": {
                    "type": "number"
                  }
                },
                "required": [
                  "angleDegrees",
                  "segments"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "sweep"
              }
            }
          },
          "then": {
            "properties": {
              "parameters": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "radius": {
                    "type": "number"
                  },
                  "segments": {
                    "type": "number"
                  }
                },
                "required": [
                  "radius",
                  "segments"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "loft"
              }
            }
          },
          "then": {
            "properties": {
              "parameters": {
                "type": "object",
                "additionalProperties": false,
                "properties": {},
                "required": []
              }
            }
          }
        }
      ]
    },
    "port": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$",
          "not": {
            "const": ".."
          }
        },
        "name": {
          "type": "string",
          "minLength": 1,
