{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hephaera.local/schemas/proof-to-model/canvas-preprocessing-profile-v1",
  "title": "Explicit separate source-canvas BiRefNet tool, not reconstruction",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "id", "mode", "baseToolchain", "executable", "files", "maxMattingChildren"],
  "properties": {
    "schemaVersion": {"const": 1}, "id": {"const": "birefnet-source-canvas-v1"}, "mode": {"const": "multi-view-four"},
    "baseToolchain": {"$ref": "#/$defs/reference"}, "executable": {"$ref": "#/$defs/file"},
    "files": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/file"}},
    "maxMattingChildren": {"const": 4},
    "existingRuntimeDependencies": {"type": "array", "minItems": 1, "maxItems": 3, "items": {
      "type": "object", "additionalProperties": false, "required": ["absolutePath", "sha256", "bytes"],
      "properties": {"absolutePath": {"type": "string", "pattern": "^[A-Za-z]:/[^:\\\\]+/CUDA/v13\\.2/bin/x64/(cublas64_13|cublasLt64_13|cudart64_13)\\.dll$"}, "sha256": {"$ref": "#/$defs/hash"}, "bytes": {"type": "integer", "minimum": 1, "maximum": 536870912}}
    }}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "reference": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/hash"}}},
    "file": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "bytes"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/hash"}, "bytes": {"type": "integer", "minimum": 1, "maximum": 536870912}}}
  },
  "$comment": "Native validation also requires exact unique paths, executable once, complete sealed bundle <=512MiB, existing-runtime single parent/no basename shadow. Existing prerequisite bytes are reported separately, not hidden in installed-bundle accounting."
}
